# Build output and tool caches. These are large (build/ alone runs to ~950MB,
# .dart_tool/ to ~150MB because it holds a whole Chrome debug profile) and are
# regenerated by `flutter pub get` / `flutter build`.
**/.dart_tool/
**/build/
**/.gradle/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/generated_plugin_registrant.*
**/GeneratedPluginRegistrant.*

# Local machine paths — differ per developer, must not be shared.
**/android/local.properties
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/macos/Flutter/Generated.xcconfig
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/

# Dependencies fetched by their own package managers.
**/ios/Pods/
**/macos/Pods/
**/.symlinks/
node_modules/

# Packaged builds.
*.apk
*.aab
*.ipa
*.jks
*.keystore

# Editor and OS noise.
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Per-machine Claude Code settings; .claude/settings.json stays tracked.
.claude/settings.local.json

# NOT ignored on purpose: art_src/ holds the 2048px source art the skins and
# branding are generated from. It is ~30MB of JPEG, but losing it means every
# asset has to be re-generated from scratch, so it is worth tracking.
